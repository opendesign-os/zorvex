# What this project sets. Every server setting, with its default and meaning,
# is in zorvex_api/settings.py; add any of them here to override it.

# --- Database ---
# The PostgreSQL container (docker compose) is created with these.
POSTGRES_USER=$slug
POSTGRES_PASSWORD=${slug}_secret
POSTGRES_DB=$slug
# Host port the container is published on.
POSTGRES_PORT=5432
# How the server connects: a libpq URL with the password URL-encoded (p@ss -> p%40ss).
# Multiple hosts, sslmode, sslrootcert and target_session_attrs work as in libpq.
DATABASE_URI=postgresql://$slug:${slug}_secret@localhost:5432/$slug

# --- Redis (optional) ---
# Set for multi-instance mode: SSE over Redis pub/sub and runs dispatched to workers
# with lease-based crash recovery. Unset, runs execute in the server process.
# REDIS_URI=redis://localhost:6379/0

# --- Model provider ---
# OPENAI_API_KEY=
# The model and system prompt the generated graph uses (src/$slug/context.py).
# MODEL=openai/gpt-4o-mini
# SYSTEM_PROMPT=

# --- Tracing (optional) ---
# Standard OpenTelemetry variables. OTEL_TRACES_EXPORTER: otlp, console or none (default).
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Bearer%20<token>

# --- Webhooks (optional) ---
# Sign run-completion webhooks the Standard Webhooks way; a whsec_ key is base64 behind the prefix.
# ZORVEX_WEBHOOK_SECRET=whsec_...
