"""Runtime context for $project_name: what each run can set."""

import os
from dataclasses import dataclass, field

from $slug import prompts


@dataclass(kw_only=True)
class Context:
    """The graph's runtime context.

    A run sets fields in its context. A field it leaves out is MODEL or SYSTEM_PROMPT from the
    environment when set, else the default here.
    """

    system_prompt: str = field(
        default_factory=lambda: os.environ.get("SYSTEM_PROMPT") or prompts.SYSTEM_PROMPT,
        metadata={"description": "The system prompt for the agent; {system_time} is the current time."},
    )
    model: str = field(
        default_factory=lambda: os.environ.get("MODEL") or "openai/gpt-4o-mini",
        metadata={
            "description": "LLM model as 'provider/model'. The model id may contain slashes for gateway "
            "routes, e.g. 'openai/deepseek-ai/DeepSeek-V3'."
        },
    )
