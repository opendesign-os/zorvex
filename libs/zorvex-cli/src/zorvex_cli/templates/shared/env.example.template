# The model provider's key: OPENAI_API_KEY for openai/... models.
# OPENAI_API_KEY=
# An OpenAI-compatible gateway, for models such as openai/deepseek-ai/DeepSeek-V3.
# OPENAI_BASE_URL=
# The graph's defaults (context.py): the model as provider/model, and the system prompt.
# MODEL=openai/gpt-4o-mini
# SYSTEM_PROMPT=

# --- Optional overrides; every server setting is in zorvex_api/settings.py ---
# The database; the default is the PostgreSQL that docker-compose.yml runs.
# DATABASE_URI=postgresql://postgres:postgres@localhost:5432/zorvex
# The host port that PostgreSQL is published on (DATABASE_URI must name it too).
# POSTGRES_PORT=5432
# Redis turns on multi-instance mode: runs go to workers, streams through pub/sub.
# REDIS_URI=redis://localhost:6379/0
# Trace export, with the standard OpenTelemetry variables.
# OTEL_TRACES_EXPORTER=otlp
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Signs run webhooks the Standard Webhooks way: whsec_ and a base64 key.
# ZORVEX_WEBHOOK_SECRET=whsec_...
